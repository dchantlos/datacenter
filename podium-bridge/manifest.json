{
  "manifest_version": 3,
  "name": "ArcGIS Podium Bridge",
  "version": "0.1.0",
  "description": "Sends a site and design brief from Data Center Site Selection to Podium, runs Podium's data centre generator in your signed-in Podium tab, and brings the designs back.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting"],
  "host_permissions": ["https://podium.app-dev.podium.io/*"],
  "externally_connectable": { "matches": ["http://localhost:5190/*", "https://dchantlos.github.io/*"] },
  "content_scripts": [{ "matches": ["https://podium.app-dev.podium.io/*"], "js": ["relay.js"], "run_at": "document_start" }]
}
